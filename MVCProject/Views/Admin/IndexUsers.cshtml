@model IEnumerable<MVCProject.BLL.Dtos.IndexUserDto>

@{
    ViewData["Title"] = @ViewBag.Role + "List";
}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        @if (ViewBag.Role == "Doctor")
        {
            <h2 class="text-primary">Doctors List</h2>
            <a asp-action="AddDoctor" asp-controller="Admin" class="btn btn-success">
                <i class="bi bi-plus-lg"></i> Add @ViewBag.Role
            </a>
        } 
        else
        {
            <h2 class="text-primary">Secertary List</h2>
            <a asp-action="AddSecertary" asp-controller="Admin" class="btn btn-success">
                <i class="bi bi-plus-lg"></i> Add @ViewBag.Role
            </a>
        }
    </div>

    <div class="card shadow-lg rounded-3">
        <div class="card-body">
            <table class="table table-hover table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Full Name</th>
                        <th scope="col">UserName</th>
                        <th scope="col">Email</th>
                        @if (ViewBag.Role == "Doctor")
                        {
                            <th scope="col">Specialization</th>
                        }
                        else
                        {
                            <th scope="col">Office Number</th>
                        }
                        <th scope="col" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int i = 1;
                        @if (ViewBag.Role == "Doctor")
                        {
                            foreach (var doctor in Model)
                            {
                                <tr>
                                    <td>@doctor.FirstName @doctor.LastName</td>
                                    <td>@doctor.UserName</td>
                                    <td>@doctor.Email</td>
                                    <td>@doctor.Specialization</td>
                                    <td class="text-center">
                                        <a asp-action="EditUser" asp-route-id="@doctor.Id"
                                           class="btn btn-sm btn-warning me-1">Edit</a>
                                        <form asp-action="DeleteUser" asp-controller="Admin" asp-route-role="Doctor" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@doctor.Id" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Are you sure you want to delete this doctor?');">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            foreach (var secretary in Model)
                            {
                                <tr>
                                    <td>@secretary.FirstName @secretary.LastName</td>
                                    <td>@secretary.UserName</td>
                                    <td>@secretary.Email</td>
                                    <td>@secretary.OfficeNumber</td>
                                    <td class="text-center">
                                        <a asp-action="EditUser" asp-route-id="@secretary.Id"
                                           class="btn btn-sm btn-warning me-1">Edit</a>
                                        <form asp-action="DeleteUser" asp-controller="Admin" asp-route-role="Secretary" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@secretary.Id" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Are you sure you want to delete this secretary?');">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">No @ViewBag.Role available</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
