@model IEnumerable<MVCProject.BLL.Dtos.IndexDoctorDto>

@{
    ViewData["Title"] = "Doctors List";
}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Doctors List</h2>
        <a asp-action="AddDoctor" asp-controller="Admin" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Add Doctor
        </a>
    </div>

    <div class="card shadow-lg rounded-3">
        <div class="card-body">
            <table class="table table-hover table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Full Name</th>
                        <th scope="col">UserName</th>
                        <th scope="col">Email</th>
                        <th scope="col">Specialization</th>
                        <th scope="col" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int i = 1;
                        foreach (var doctor in Model)
                        {
                            <tr>
                                <td>@doctor.FirstName @doctor.LastName</td>
                                <td>@doctor.UserName</td>
                                <td>@doctor.Email</td>
                                <td>@doctor.Specialization</td>
                                <td class="text-center">
                                    <a asp-action="EditUser" asp-route-id="@doctor.Id"
                                       class="btn btn-sm btn-warning me-1">Edit</a>
                                    <form asp-action="DeleteDoctor" asp-controller="Admin" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@doctor.Id" />
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger"
                                                onclick="return confirm('Are you sure you want to delete this doctor?');">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">No doctors available</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
